<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->

    <style name="Base.Theme.TresEnRaya" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->

    </style>

    <!-- ESTILOS CELDAS -->
    <style name="boton">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textSize">50sp</item>
        <item name="android:gravity">center</item>

    </style>

    <!-- ESTILOS TEXTO TURNO -->
    <style name="turno">
        <item name="android:textSize">40sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- ESTILOS BOTON RESET -->
    <style name="reset_boton">
        <item name="android:background">@color/color_x</item>
        <item name="android:textColor">@color/color_o</item>
        <item name="android:textSize">25sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- ESTILOS LINEAS TABLERO -->
    <style name="linea_tablero">

        <item name="android:background">@color/black</item>

    </style>



    <style name="Theme.TresEnRaya" parent="Base.Theme.TresEnRaya" />
</resources>