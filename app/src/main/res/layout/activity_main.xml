<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- LINEAS DE SOPORTE HORIZONTALES -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/GLH1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/GLH2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/GLH3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/GLH4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/GLH5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/GLH6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <!-- LINEAS DE SOPORTE VERTICALES -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/GLV1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/GLV2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.33"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/GLV3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.66"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/GLV4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <!-- TEXTO TURNO -->
    <TextView
        android:id="@+id/turno"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        app:layout_constraintBottom_toTopOf="@id/GLH5"
        app:layout_constraintTop_toBottomOf="@id/GLH6"
        app:layout_constraintStart_toEndOf="@id/GLV1"
        app:layout_constraintEnd_toStartOf="@id/GLV4"
        style="@style/turno"
        />

    <!-- BOTON RESET -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btreset"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/GLH1"
        app:layout_constraintTop_toBottomOf="@id/GLH2"
        app:layout_constraintStart_toEndOf="@id/GLV2"
        app:layout_constraintEnd_toStartOf="@id/GLV3"
        android:text="@string/reset"
        style="@style/reset_boton"
        />

    <!-- BOTONES PARA LAS CELDAS DEL JUEGO -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt11"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/GLH4"
        app:layout_constraintTop_toBottomOf="@id/GLH5"
        app:layout_constraintStart_toEndOf="@id/GLV1"
        app:layout_constraintEnd_toStartOf="@id/GLV2"
        style="@style/boton"
        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt12"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/GLH4"
        app:layout_constraintTop_toBottomOf="@id/GLH5"
        app:layout_constraintStart_toEndOf="@id/GLV2"
        app:layout_constraintEnd_toStartOf="@id/GLV3"
        style="@style/boton"
        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt13"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/GLH4"
        app:layout_constraintTop_toBottomOf="@id/GLH5"
        app:layout_constraintStart_toEndOf="@id/GLV3"
        app:layout_constraintEnd_toStartOf="@id/GLV4"
        style="@style/boton"
        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt21"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/GLH3"
        app:layout_constraintTop_toBottomOf="@id/GLH4"
        app:layout_constraintStart_toEndOf="@id/GLV1"
        app:layout_constraintEnd_toStartOf="@id/GLV2"
        style="@style/boton"
        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt22"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/GLH3"
        app:layout_constraintTop_toBottomOf="@id/GLH4"
        app:layout_constraintStart_toEndOf="@id/GLV2"
        app:layout_constraintEnd_toStartOf="@id/GLV3"
        style="@style/boton"
        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt23"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/GLH3"
        app:layout_constraintTop_toBottomOf="@id/GLH4"
        app:layout_constraintStart_toEndOf="@id/GLV3"
        app:layout_constraintEnd_toStartOf="@id/GLV4"
        style="@style/boton"
        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt31"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/GLH2"
        app:layout_constraintTop_toBottomOf="@id/GLH3"
        app:layout_constraintStart_toEndOf="@id/GLV1"
        app:layout_constraintEnd_toStartOf="@id/GLV2"
        style="@style/boton"
        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt32"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/GLH2"
        app:layout_constraintTop_toBottomOf="@id/GLH3"
        app:layout_constraintStart_toEndOf="@id/GLV2"
        app:layout_constraintEnd_toStartOf="@id/GLV3"
        style="@style/boton"
        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bt33"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/GLH2"
        app:layout_constraintTop_toBottomOf="@id/GLH3"
        app:layout_constraintStart_toEndOf="@id/GLV3"
        app:layout_constraintEnd_toStartOf="@id/GLV4"
        style="@style/boton"
        />

    <!-- LINEAS DEL TABLERO -->
    <View
        android:id="@+id/lineTurno"
        android:layout_width="0dp"
        android:layout_height="4dp"
        app:layout_constraintTop_toBottomOf="@id/GLH5"
        app:layout_constraintBottom_toTopOf="@id/GLH5"
        app:layout_constraintStart_toEndOf="@+id/GLV1"
        app:layout_constraintEnd_toStartOf="@id/GLV4"
        style="@style/linea_tablero"
        />

    <View
        android:id="@+id/lineH4"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"
        app:layout_constraintTop_toBottomOf="@id/GLH4"
        app:layout_constraintBottom_toTopOf="@id/GLH4"
        app:layout_constraintStart_toEndOf="@+id/GLV1"
        app:layout_constraintEnd_toStartOf="@id/GLV4"
        style="@style/linea_tablero"
        />

    <View
        android:id="@+id/lineH3"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"
        app:layout_constraintTop_toBottomOf="@id/GLH3"
        app:layout_constraintBottom_toTopOf="@id/GLH3"
        app:layout_constraintStart_toEndOf="@+id/GLV1"
        app:layout_constraintEnd_toStartOf="@id/GLV4"
        style="@style/linea_tablero"
        />

    <View
        android:id="@+id/lineReset"
        android:layout_width="0dp"
        android:layout_height="4dp"
        app:layout_constraintTop_toBottomOf="@id/GLH2"
        app:layout_constraintBottom_toTopOf="@id/GLH2"
        app:layout_constraintStart_toEndOf="@+id/GLV1"
        app:layout_constraintEnd_toStartOf="@id/GLV4"
        style="@style/linea_tablero"
        />

    <View
        android:id="@+id/lineV1"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/GLH5"
        app:layout_constraintBottom_toTopOf="@id/GLH2"
        app:layout_constraintStart_toEndOf="@+id/GLV2"
        app:layout_constraintEnd_toStartOf="@id/GLV2"
        style="@style/linea_tablero"
        />

    <View
        android:id="@+id/lineV2"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/GLH5"
        app:layout_constraintBottom_toTopOf="@id/GLH2"
        app:layout_constraintStart_toEndOf="@+id/GLV3"
        app:layout_constraintEnd_toStartOf="@id/GLV3"
        style="@style/linea_tablero"
        />


</androidx.constraintlayout.widget.ConstraintLayout>